load("@rules_python//python:defs.bzl", "py_library", "py_test")


py_library(
    name = "lobster_online_report",
    srcs = [
        "lobster_online_report_system_test_case_base.py",
        "lobster_online_report_test_runner.py",
    ],
    data = [
        "//tests_system/lobster_online_report/data:online_report_data_system",
    ],
    visibility = [
        "//visibility:public",
    ],
    deps = [
        "//:lobster",
        "//tests_system",
    ],
)

test_suite(
    name = "lobster_online_report_tests",
)

[py_test(
    name = src[:-3],
    srcs = [src],
    deps = [":lobster_online_report"],
) for src in glob(["test_*.py"], exclude = [
    "test_valid_cases.py",
    "test_commit_value.py",
])]

# Runs the host's git executable, which Bazel does not track as an input.
# "local" disables sandboxing so that git is found on the host, and it documents that
# the test is not hermetic.
py_test(
    name = "test_commit_value",
    srcs = ["test_commit_value.py"],
    tags = ["local"],
    deps = [":lobster_online_report"],
)

py_test(
    name = "test_valid_cases",
    srcs = ["test_valid_cases.py"],
    deps = [
        ":lobster_online_report",
        "//lobster/common:common"
    ],
)
