"""Runs lobster-junit on JUnit XML test reports, e.g. those of test_report."""

load("//bazel:providers.bzl", "LobsterProvider")

def _lobster_junit_subrule_impl(ctx, reports, _lobster_junit, *, derive_gwt_from_test_name = False):
    lobster_junit_trace = ctx.actions.declare_file(ctx.label.name + ".lobster")

    args = ctx.actions.args()
    args.add_all(["--out", lobster_junit_trace.path])
    if derive_gwt_from_test_name:
        args.add("--derive-gwt-from-test-name")
    args.add_all(reports)

    ctx.actions.run(
        executable = _lobster_junit,
        inputs = reports,
        outputs = [lobster_junit_trace],
        arguments = [args],
        progress_message = "lobster-junit {}".format(lobster_junit_trace.path),
    )

    return [
        lobster_junit_trace,
        LobsterProvider(lobster_input = {lobster_junit_trace.basename: lobster_junit_trace.path}),
    ]

subrule_lobster_junit = subrule(
    implementation = _lobster_junit_subrule_impl,
    attrs = {
        "_lobster_junit": attr.label(
            default = "//:lobster-junit",
            executable = True,
            cfg = "exec",
        ),
    },
)

def _lobster_junit(ctx):
    lobster_junit_trace, lobster_provider = subrule_lobster_junit(
        ctx.files.tests,
        derive_gwt_from_test_name = ctx.attr.derive_gwt_from_test_name,
    )
    return [DefaultInfo(files = depset([lobster_junit_trace])), lobster_provider]

lobster_junit = rule(
    implementation = _lobster_junit,
    attrs = {
        "tests": attr.label_list(
            allow_empty = False,
            allow_files = [".xml"],
            mandatory = True,
            doc = "JUnit XML test reports, e.g. generated by test_report.",
        ),
        "derive_gwt_from_test_name": attr.bool(
            default = False,
            doc = "Derive the Given, When and Then parts from the test names, " +
                  "unless a test records one of them itself.",
        ),
    },
    subrules = [subrule_lobster_junit],
)
