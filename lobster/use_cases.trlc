package UseCases
import req

/**
 * The role "traceability manager" is meant to be a placeholder role for a requirements
 * manager, test manager or quality manager. LOBSTER is a generic traceability tool, so
 * it can be used in many different contexts.
 *
 * The role "user" refers to any individual who interacts with any LOBSTER tool,
 * like a CI administrator who integrates LOBSTER into their continuous integration
 * pipeline, or a reader of the HTML report.
 */

section "Generic" {
    /**
     * This section contains use cases which are agnostic of the type of the actually
     * traced data. They do not know if the user wants to measure the coverage of
     * requirements, tests, source code functions, bug issues, architecture elements,
     * or any other type of traceable artifact.
     */

    req.UseCase List_Ok_Items {
        description = '''
            As a traceability manager I want the traceability report to list items that
            fulfill the tracing policy, and how they do so,
            so that I can decide whether to release my product.

            Example:
            If the tracing policy is: Tests --(trace to)--> Requirements,
            then the report shall list all tests that link to at least one requirement,
            and the report shall list all linked requirements per test.

            The use case applies to the reverse direction as well.
        '''
        affected_tools = [
            // extractor tools
            req.Tools.lobster_codebeamer,
            req.Tools.lobster_trlc,
            req.Tools.lobster_json,
            req.Tools.lobster_cpptest,
            req.Tools.lobster_pkg,

            // generator/rendering tools:
            req.Tools.lobster_report,
            req.Tools.lobster_ci_report,
            req.Tools.lobster_html_report,
            req.Tools.lobster_rst_report,
        ]
    }

    req.UseCase List_Not_Ok_Items {
        description = '''
            As a traceability manager I want the traceability report to list items that
            are not covered by other items, where coverage rules are specified by the
            tracing policy,
            so that I can identify gaps in the coverage.

            Example:
            If the tracing policy is: Tests --(trace to)--> Requirements,
            then the report shall list all tests that do not link to any requirement.

            The use case applies to the reverse direction as well.
        '''
        affected_tools = [
            // extractor tools
            req.Tools.lobster_codebeamer,
            req.Tools.lobster_trlc,
            req.Tools.lobster_json,
            req.Tools.lobster_cpptest,
            req.Tools.lobster_pkg,

            // generator/rendering tools:
            req.Tools.lobster_report,
            req.Tools.lobster_ci_report,
            req.Tools.lobster_html_report,
            req.Tools.lobster_rst_report,
        ]
    }

    req.UseCase Item_Coverage {
        description = '''
            As a traceability manager I want the traceability report to show the fraction
            of the number of items in one level (of the tracing policy)
            which fulfill the tracing policy,
            divided by the total number of items in that level (of the tracing policy).
            The fraction shall be shown as percentage.

            Example:
            If the tracing policy is: Tests --(trace to)--> Requirements,
            then the report shall show the fraction of requirements which are covered by at
            least one test, divided by the total number of requirements.
        '''
        affected_tools = [
            // extractor tools
            req.Tools.lobster_codebeamer,
            req.Tools.lobster_trlc,
            req.Tools.lobster_json,
            req.Tools.lobster_cpptest,
            req.Tools.lobster_pkg,

            // generator/rendering tools:
            req.Tools.lobster_report,
            req.Tools.lobster_ci_report,
            req.Tools.lobster_html_report,
            req.Tools.lobster_rst_report,
        ]
    }

    req.UseCase Tool_Usability {
        description = '''
            As a user of LOBSTER I want to have a good usability and standard
            command-line ergonomics, like built-in help or automatic creation of output
            destinations,
            so that using the tools is intuitive and seamless in scripts and interactive
            use.
        '''
        affected_tools = [
            // extractor tools
            req.Tools.lobster_codebeamer,
            req.Tools.lobster_trlc,
            req.Tools.lobster_json,
            req.Tools.lobster_cpptest,
            req.Tools.lobster_pkg,

            // generator/rendering tools:
            req.Tools.lobster_report,
            req.Tools.lobster_ci_report,
            req.Tools.lobster_html_report,
            req.Tools.lobster_rst_report,
            req.Tools.lobster_online_report,
        ]
    }
}

req.UseCase List_Requirements_to_Tests {
    deprecated_by = List_Ok_Items
    description = '''
        As a requirements manager I want the traceability report to show the list of
        requirements which are covered by tests.
    '''
    affected_tools = [
        // shall extract requirements:
        req.Tools.lobster_codebeamer,
        req.Tools.lobster_trlc,

        // shall extract test cases:
        req.Tools.lobster_json,
        req.Tools.lobster_cpptest,
        req.Tools.lobster_pkg,

        // shall generate reports:
        req.Tools.lobster_report,
        req.Tools.lobster_html_report,
        req.Tools.lobster_rst_report
    ]
}

req.UseCase List_Requirements_without_Tests {
    deprecated_by = List_Not_Ok_Items
    description = '''
        As a requirements manager I want the traceability report to show the list of
        requirements which are not covered by tests.
    '''
    affected_tools = [
        // shall extract requirements:
        req.Tools.lobster_codebeamer,
        req.Tools.lobster_trlc,

        // shall extract test cases:
        req.Tools.lobster_json,
        req.Tools.lobster_cpptest,
        req.Tools.lobster_pkg,

        // shall generate reports:
        req.Tools.lobster_report,
        req.Tools.lobster_html_report,
        req.Tools.lobster_rst_report
    ]
}

